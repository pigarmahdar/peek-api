#!/usr/bin/env bash
set -e

# Resolve script directory across symlinks
SCRIPT_PATH="$(python3 -c 'import os, sys; print(os.path.realpath(sys.argv[1]))' "$0" 2>/dev/null || echo "$0")"
REPO_DIR="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"

RELEASE_BIN="$REPO_DIR/.build/release/peek"
DEBUG_BIN="$REPO_DIR/.build/debug/peek"

# Prefer release binary if available, otherwise debug
if [ -x "$RELEASE_BIN" ]; then
    TARGET_BIN="$RELEASE_BIN"
elif [ -x "$DEBUG_BIN" ]; then
    TARGET_BIN="$DEBUG_BIN"
else
    echo "⚡ Building peek-api..."
    (cd "$REPO_DIR" && swift build -c release)
    TARGET_BIN="$RELEASE_BIN"
fi

# If invoked to launch the app: `peek api` or `peek`
if { [ "$1" = "api" ] && [ $# -eq 1 ]; } || [ $# -eq 0 ]; then
    if pgrep -x "peek" >/dev/null 2>&1; then
        echo "⚡ peek-api is already running in your menu bar."
        exit 0
    fi
    nohup "$TARGET_BIN" api >/dev/null 2>&1 &
    echo "⚡ peek-api launched in menu bar."
    exit 0
fi

# Forward CLI arguments (e.g. login commands, --help)
exec "$TARGET_BIN" "$@"
